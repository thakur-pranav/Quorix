# Copy to backend/.env and fill in real values. Never commit .env.

# SQLite file locally; Postgres (Neon) in production
DATABASE_URL=sqlite:///./data/quorix.db

# Shared with the Next.js server. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BACKEND_JWT_SECRET=

# The only origin allowed to call the API from a browser (comma-separated if more than one)
CORS_ORIGINS=http://localhost:3000
