# For `docker compose up` only. Copy to .env (git-ignored) and fill in. The two apps' own
# settings for local development live in backend/.env and frontend/.env.local.
#
# Generate each secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_PASSWORD=
# At least 32 characters; the frontend and backend share it (it signs the service token).
BACKEND_JWT_SECRET=
# At least 32 characters, and different from BACKEND_JWT_SECRET (it signs login sessions).
AUTH_SECRET=

# Optional: real answers. Without a key, chat still works and returns the closest passages.
LLM_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
JUDGE_MODEL=qwen/qwen3.8-27b
