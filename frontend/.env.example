# Copy to .env.local and fill in. Never commit .env.local.
# Generate each secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Users and sessions
MONGODB_URI=mongodb://127.0.0.1:27017/quorix
# Signs the browser session cookie. At least 32 characters.
AUTH_SECRET=
# Signs the 60 s service token for FastAPI. Must equal BACKEND_JWT_SECRET in backend/.env,
# and must differ from AUTH_SECRET.
BACKEND_JWT_SECRET=

# Where the Next.js server reaches FastAPI (never exposed to the browser)
FASTAPI_BASE_URL=http://127.0.0.1:8000

# Same list as the backend's READ_ONLY_ORGS: hides write controls for the demo.
READ_ONLY_ORGS=
